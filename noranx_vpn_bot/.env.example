BOT_TOKEN=
ADMIN_IDS=123456789,987654321
# Host network / local run (docker postgres on 5433, redis on 6380):
DATABASE_URL=postgresql+asyncpg://noranx:noranx@127.0.0.1:5433/noranx_bot
REDIS_URL=redis://127.0.0.1:6380/0
# Docker bridge network (bot service without host mode):
# DATABASE_URL=postgresql+asyncpg://noranx:noranx@postgres:5432/noranx_bot
# REDIS_URL=redis://redis:6379/0

# API base URL (localhost on same VPS). Use https if Marzban has UVICORN_SSL_* enabled.
MARZBAN_URL=https://127.0.0.1:18000
MARZBAN_USER=
MARZBAN_PASS=
MARZBAN_DRY_RUN=false
MARZBAN_VERIFY_SSL=false

IP_LIMITER_URL=http://127.0.0.1:6284
IP_LIMITER_API_USER=
IP_LIMITER_API_PASS=
# Set true until device limiter (port 3000) is deployed; IP limiter can run separately
PROVISION_SKIP_LIMITERS=true

MARZBAN_WEBHOOK_SECRET=
REQUIRED_CHANNEL_ID=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# false = production API (api.nowpayments.io). Sandbox needs a separate key from sandbox.nowpayments.io
NOWPAYMENTS_SANDBOX=false

C2C_MOCK=true
C2C_WEBHOOK_SECRET=change-me-c2c
C2C_ENABLED=true
C2C_DEST_CARD=
C2C_DEST_NAME=
C2C_REVIEW_CHANNEL_ID=
C2C_OCR_ENABLED=true
C2C_SMS_ENABLED=false
C2C_SMS_BANK=custom
C2C_SMS_PATTERNS=[]

WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
PUBLIC_WEBHOOK_BASE_URL=https://bot.yourdomain.com

LOG_LEVEL=INFO
DEBUG=false
MAX_PURCHASE_QUANTITY=10

REFERRAL_DISCOUNT_PERCENT=10
REFERRAL_DISCOUNT_VALID_DAYS=30

FX_SOURCE=tgju
FX_USD_IRR_MANUAL=1777000
FX_CACHE_TTL_SECONDS=600
FX_MIN_USD_RECHARGE=5
TRIAL_SYNC_INTERVAL_MINUTES=5
