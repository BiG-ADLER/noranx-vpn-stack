# Marzban Device Limiter Configuration
# Copy this file to .env and fill in your values

# Marzban instance URL (required)
# Examples:
#   - Same server: http://127.0.0.1:8000
#   - Docker network: http://marzban:8000
#   - Remote server: http://your-marzban-ip:8000
MARZBAN_URL=http://127.0.0.1:8000

# Limiter listening port (default: 3000)
PORT=3000

# Data directory for SQLite database (default: /data)
DATA_DIR=/data

# Default device limit for new users (default: 3)
DEFAULT_DEVICE_LIMIT=3
